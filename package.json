{
  "name": "careerpilot-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "test": "node --test src/*.test.js server/*.test.js",
    "server": "node server/index.js",
    "start": "node scripts/dev.mjs --preview",
    "careerpilot:dev": "npm --prefix apps/careerpilot-ai run dev",
    "careerpilot:build": "npm --prefix apps/careerpilot-ai run build",
    "careerpilot:test": "npm --prefix apps/careerpilot-ai test",
    "guest:dev": "node scripts/dev.mjs --guest",
    "careerpilot-ai:dev": "npm --prefix apps/careerpilot-ai run dev",
    "careerpilot-ai:build": "npm --prefix apps/careerpilot-ai run build",
    "careerpilot-ai:test": "npm --prefix apps/careerpilot-ai test"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.8.15",
    "cheerio": "^1.2.0",
    "docx": "^9.0.0",
    "jspdf": "^3.0.0",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.0",
    "pdfjs-dist": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^6.0.0",
    "vite": "^7.0.0"
  }
}
