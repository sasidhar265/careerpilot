# Server only. Never use a VITE_ prefix for secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Choose OpenAI API or locally authenticated Codex CLI.
AI_PROVIDER=openai
# Optional Codex model; blank uses the CLI default.
CODEX_MODEL=
CODEX_CLI_PATH=codex

# GitHub Copilot CLI uses the existing Copilot login.
COPILOT_CLI_PATH=copilot
COPILOT_MODEL=
# Optional token for a headless environment; keep server-side.
COPILOT_GITHUB_TOKEN=

# Optional official NHS Jobs XML/RSS feed URL from NHSBSA self-serve guidance.
# HTTPS jobs.nhs.uk host only. Leave blank until you have a valid feed URL.
NHS_JOBS_FEED_URL=
# Refresh public employer feeds while the backend runs.
JOB_REFRESH_MINUTES=60
JOB_AUTO_REFRESH=true

# Public employer boards: defaults to the built-in UK technology employer directory.
# Leave blank for defaults. Use [] to disable defaults or a JSON array to override.
# Additional boards connected in the UI are saved separately in .data/employers.json.
JOB_EMPLOYER_BOARDS=
