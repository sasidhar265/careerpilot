{
  "name": "careerpilot-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "prisma generate && next build",
    "start": "next start --port 3100",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts tests/unit/*.test.mjs",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "jobs:ingest": "node --conditions=react-server --import tsx scripts/ingest.ts",
    "data:import": "node --conditions=react-server --import tsx scripts/import-legacy.ts",
    "jobs:reindex": "node --conditions=react-server --import tsx scripts/reindex.ts",
    "test:integration": "node --conditions=react-server --import tsx --test tests/integration/*.test.ts",
    "preflight": "node --experimental-strip-types scripts/preflight.ts",
    "test:integration:required": "node --experimental-strip-types scripts/run-required-tests.mjs integration",
    "test:e2e:journey": "node --experimental-strip-types scripts/run-required-tests.mjs journey",
    "test:e2e:local-auth": "node ./node_modules/@playwright/test/cli.js test --config playwright.local.config.ts",
    "test:e2e:guest": "node ./node_modules/@playwright/test/cli.js test --config playwright.guest.config.ts",
    "predev": "node ../../scripts/build-guest.mjs",
    "prebuild": "node ../../scripts/build-guest.mjs",
    "guest:build": "node ../../scripts/build-guest.mjs",
    "test:guest:compile": "node scripts/verify-guest-route.mjs",
    "test:auth:local": "node --conditions=react-server --experimental-strip-types scripts/verify-local-auth.mjs",
    "test:auth:compile": "node scripts/verify-local-auth-build.mjs",
    "test:extraction:runtime": "node scripts/verify-extraction-runtime.mjs",
    "test:profile:save": "node --conditions=react-server scripts/verify-profile-save.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@prisma/client": "7.9.1",
    "@prisma/adapter-pg": "7.9.1",
    "pg": "^8.16.3",
    "openid-client": "^6.8.0",
    "jose": "^6.1.0",
    "zod": "^4.1.12",
    "server-only": "^0.0.1",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.0",
    "dotenv": "^16.6.1",
    "pdfjs-dist": "^5.0.0",
    "docx": "^9.5.1",
    "jspdf": "^3.0.3"
  },
  "devDependencies": {
    "prisma": "7.9.1",
    "typescript": "5.9.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/pg": "^8.15.5",
    "tailwindcss": "^4.1.16",
    "@tailwindcss/postcss": "^4.1.16",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.2",
    "@playwright/test": "^1.56.0",
    "tsx": "^4.20.6"
  }
}
