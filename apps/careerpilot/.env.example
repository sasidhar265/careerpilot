# Copy this file to apps/careerpilot/.env. Existing root .env stays unchanged.
DATABASE_URL=postgresql://careerpilot:CHANGE_ME@localhost:5432/careerpilot
APP_URL=http://localhost:3100
# Docker Compose only: choose a URL-safe random password; DATABASE_URL must match it.
POSTGRES_PASSWORD=
# Generate: openssl rand -base64 48. At least 32 characters; never use a VITE_/NEXT_PUBLIC_ prefix.
AUTH_MODE=oidc
# Local development only: set AUTH_MODE=file for password/file-backed sign-in.
# Relative to apps/careerpilot; private hashes/sessions, excluded from Git/images.
AUTH_FILE_PATH=.local/auth/accounts.json
AUTH_SECRET=
# OpenID Connect: register APP_URL/api/auth/callback with your identity provider.
AUTH_ISSUER=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Existing authenticated CLI providers can also be selected server-side.
CODEX_CLI_PATH=codex
COPILOT_CLI_PATH=copilot
COPILOT_MODEL=
AI_DAILY_LIMIT=20
# Explicitly configure employer boards you may access and display. Empty / [] means no refresh sources.
# JSON array: provider (greenhouse/lever/ashby/smartrecruiters), board, company, region (global/eu).
JOB_EMPLOYER_BOARDS=
# Optional verified company facts array: key, companySize, companyType, industry, sourceUrl, verifiedAt.
JOB_COMPANY_FACTS=[]
# Enables full-UK-postcode radius lookup and exact-postcode job coordinate enrichment.
JOB_GEOCODING_ENABLED=false
# NI postcode data has additional licensing conditions. Enable only for a permitted use.
JOB_NI_POSTCODES_ALLOWED=false
# Non-destructive import input path, relative to the new app.
LEGACY_CATALOGUE_PATH=../../.data/jobs.json
# For E2E only: must point to a database whose name ends in _test.
E2E_DATABASE_URL=

# PostgreSQL integration tests only; isolated database name must end in _test.
INTEGRATION_DATABASE_URL=

# Private originals: JSON map of key IDs to base64 32-byte keys. Retain old keys.
DOCUMENT_ENCRYPTION_KEYS=
DOCUMENT_ACTIVE_KEY_ID=

# Optional administrator-provided Unicode TTF fonts; configure both or leave both blank.
RESUME_PDF_FONT_REGULAR=
RESUME_PDF_FONT_BOLD=

# Test runner only: E2E_PROVIDER_FIXTURES=1 enables explicit isolated external fixtures.
# Never configure this flag or fixture NODE_OPTIONS preloads on production services.

# Guest is bundled at /guest automatically; no second server or URL is required.
